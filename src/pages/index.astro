---
import "../styles/global.css";
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>대치프라임 성적표 시스템</title>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans min-h-screen">
    <div id="app-screen">
      <header class="bg-white border-b border-gray-100 sticky top-0 z-10">
        <div class="max-w-5xl mx-auto px-4 py-4">
          <h1 class="text-base font-bold text-brand-dark">대치프라임 성적표 시스템</h1>
        </div>
        <div class="max-w-5xl mx-auto px-4 flex gap-1">
          <button data-tab="exams" class="tab-btn px-4 py-2.5 text-sm font-bold border-b-2 border-brand text-brand-dark">
            시험 관리
          </button>
          <button data-tab="report" class="tab-btn px-4 py-2.5 text-sm font-bold border-b-2 border-transparent text-gray-400">
            성적표
          </button>
        </div>
      </header>

      <main class="max-w-5xl mx-auto px-4 py-8">
        <!-- 탭: 시험 관리 -->
        <section data-tab-panel="exams">
          <div class="bg-white rounded-xl border border-gray-100 p-6 mb-6">
            <h2 class="text-sm font-bold text-gray-900 mb-4">새 시험 만들기</h2>
            <div class="space-y-4">
              <div>
                <label class="block text-xs font-bold text-gray-500 mb-2">대상학년 (중복 선택 가능)</label>
                <div id="grade-checkboxes" class="flex flex-wrap gap-2"></div>
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-500 mb-2">과목 (중복 선택 가능)</label>
                <div id="subject-checkboxes" class="flex flex-wrap gap-2"></div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-bold text-gray-500 mb-1">시험 이름</label>
                  <input id="new-exam-name" type="text" placeholder="예: 9월 모의고사" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
                </div>
                <div></div>
                <div>
                  <label class="block text-xs font-bold text-gray-500 mb-1">시행 시작일</label>
                  <input id="new-exam-start" type="date" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-gray-500 mb-1">시행 종료일</label>
                  <input id="new-exam-end" type="date" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
                </div>
              </div>
              <div class="flex items-center gap-3">
                <button id="create-exam-btn" class="px-4 py-2 rounded-lg bg-brand text-white text-sm font-bold hover:bg-brand-dark">
                  시험 만들기
                </button>
                <p id="create-exam-result" class="text-xs text-gray-500"></p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl border border-gray-100 p-6">
            <h2 class="text-sm font-bold text-gray-900 mb-4">시험 목록</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b-2 border-gray-900 text-left text-xs text-gray-500">
                    <th class="py-2 pr-4">대상학년</th>
                    <th class="py-2 pr-4">과목</th>
                    <th class="py-2 pr-4">시험명</th>
                    <th class="py-2 pr-4">시행기간</th>
                    <th class="py-2 pr-4">학생수</th>
                    <th class="py-2"></th>
                  </tr>
                </thead>
                <tbody id="exams-tbody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- 탭: 성적표 -->
        <section data-tab-panel="report" hidden>
          <div class="bg-white rounded-xl border border-gray-100 p-6 mb-6 grid grid-cols-1 sm:grid-cols-3 gap-3">
            <select id="report-exam-select" class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand"></select>
            <select id="report-grade-select" class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand"></select>
            <input
              id="student-search"
              type="text"
              placeholder="학생 이름 검색"
              class="border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand"
            />
          </div>

          <div class="bg-white rounded-xl border border-gray-100 p-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b-2 border-gray-900 text-left text-xs text-gray-500">
                  <th class="py-2 pr-4">이름</th>
                  <th class="py-2 pr-4">응시 과목</th>
                  <th class="py-2"></th>
                </tr>
              </thead>
              <tbody id="students-tbody"></tbody>
            </table>
          </div>
        </section>
      </main>
    </div>

    <!-- 시험 상세(명단 관리) 모달 -->
    <div id="exam-detail-modal" hidden class="fixed inset-0 bg-black/40 flex items-center justify-center z-40 p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-auto">
        <div class="p-6 border-b border-gray-100 flex items-start justify-between gap-4">
          <div>
            <h3 id="ed-title" class="text-base font-bold text-gray-900"></h3>
            <p id="ed-meta" class="text-xs text-gray-500 mt-1"></p>
          </div>
          <button id="ed-close-btn" class="text-sm text-gray-400 hover:text-gray-600">닫기</button>
        </div>

        <div class="p-6 border-b border-gray-100">
          <h4 class="text-sm font-bold text-gray-900 mb-2">엑셀로 명단 업로드</h4>
          <p class="text-xs text-gray-500 mb-3">컬럼 순서(첫 행은 헤더): <b>학년 | 과목 | 이름 | 점수</b></p>
          <input
            id="ed-excel-input"
            type="file"
            accept=".xlsx,.xls"
            class="block w-full text-sm text-gray-700 file:mr-3 file:px-4 file:py-2 file:rounded-lg file:border-0 file:bg-brand file:text-white file:text-sm file:font-bold hover:file:bg-brand-dark"
          />
          <p id="ed-upload-result" class="text-xs text-gray-500 mt-2"></p>
        </div>

        <div class="p-6 border-b border-gray-100">
          <h4 class="text-sm font-bold text-gray-900 mb-3">학생 직접 추가</h4>
          <div class="flex flex-wrap gap-2">
            <select id="ed-add-grade" class="border border-gray-200 rounded-lg px-2 py-1.5 text-sm"></select>
            <select id="ed-add-subject" class="border border-gray-200 rounded-lg px-2 py-1.5 text-sm"></select>
            <input id="ed-add-name" placeholder="이름" class="flex-1 min-w-[100px] border border-gray-200 rounded-lg px-2 py-1.5 text-sm" />
            <input id="ed-add-score" type="number" placeholder="점수" class="w-24 border border-gray-200 rounded-lg px-2 py-1.5 text-sm" />
            <button id="ed-add-btn" class="px-3 py-1.5 rounded-lg bg-brand text-white text-sm font-bold hover:bg-brand-dark">추가</button>
          </div>
        </div>

        <div class="p-6">
          <h4 class="text-sm font-bold text-gray-900 mb-3">명단</h4>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b-2 border-gray-900 text-left text-xs text-gray-500">
                  <th class="py-2 pr-3">학년</th>
                  <th class="py-2 pr-3">과목</th>
                  <th class="py-2 pr-3">이름</th>
                  <th class="py-2 pr-3">점수</th>
                  <th class="py-2 pr-3">반평균</th>
                  <th class="py-2 pr-3">표준편차</th>
                  <th class="py-2 pr-3">석차</th>
                  <th class="py-2"></th>
                </tr>
              </thead>
              <tbody id="ed-roster-tbody"></tbody>
            </table>
          </div>
        </div>

        <div class="p-6 border-t border-gray-100">
          <h4 class="text-sm font-bold text-gray-900 mb-2">이 시험에 대한 총평</h4>
          <p class="text-xs text-gray-500 mb-3">성적표 하단에 표시됩니다.</p>
          <textarea
            id="ed-comment"
            rows="4"
            placeholder="예: 이번 시험은 전반적으로 어려웠고, 특히 서술형 문항에서 변별력이 컸습니다."
            class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand"
          ></textarea>
          <div class="flex items-center gap-3 mt-2">
            <button id="ed-comment-save-btn" class="px-4 py-2 rounded-lg bg-brand text-white text-sm font-bold hover:bg-brand-dark">
              저장
            </button>
            <p id="ed-comment-result" class="text-xs text-gray-500"></p>
          </div>
        </div>
      </div>
    </div>

    <!-- 성적표 미리보기 모달 -->
    <div id="preview-modal" hidden class="fixed inset-0 bg-black/40 flex items-center justify-center z-50 p-4">
      <div class="bg-white rounded-xl shadow-xl max-w-full max-h-[90vh] overflow-auto">
        <div
          id="report-template"
          style="position:relative; width:794px; min-height:1123px; max-width:100%; padding:64px 56px; background:#ffffff; font-family:'Noto Sans KR','Apple SD Gothic Neo',sans-serif; box-sizing:border-box; display:flex; flex-direction:column; overflow:hidden;"
        >
          <img
            src="/logo.png"
            style="position:absolute; top:50%; left:50%; width:440px; height:440px; transform:translate(-50%,-50%); opacity:0.055; z-index:0; pointer-events:none;"
          />

          <div style="position:relative; z-index:1; text-align:center; margin-bottom:28px;">
            <img src="/logo.png" style="width:64px; height:64px; margin:0 auto 12px; display:block;" />
            <p id="rt-academy" style="font-size:13px; color:#8a8fad; letter-spacing:3px; font-weight:700; margin:0;">대치프라임 학원</p>
            <h1 id="rt-exam-name" style="font-size:26px; font-weight:800; color:#2e3250; margin:8px 0 0;"></h1>
            <p id="rt-exam-meta" style="font-size:13px; color:#8a8fad; margin:4px 0 0;"></p>
          </div>
          <div style="position:relative; z-index:1; text-align:center; padding:18px 0 22px; border-bottom:3px solid #2e3250; margin-bottom:18px;">
            <p style="font-size:12px; color:#8a8fad; margin:0;">학생</p>
            <p id="rt-student-name" style="font-size:30px; font-weight:800; color:#2e3250; margin:4px 0 0;"></p>
          </div>
          <table style="position:relative; z-index:1; width:100%; border-collapse:collapse;">
            <thead>
              <tr style="border-bottom:2px solid #2e3250;">
                <th style="text-align:left; padding:8px 6px; font-size:13px; color:#2e3250;">과목</th>
                <th style="text-align:right; padding:8px 6px; font-size:13px; color:#2e3250;">점수</th>
                <th style="text-align:right; padding:8px 6px; font-size:13px; color:#2e3250;">반평균</th>
                <th style="text-align:right; padding:8px 6px; font-size:13px; color:#2e3250;">표준편차</th>
                <th style="text-align:right; padding:8px 6px; font-size:13px; color:#2e3250;">석차</th>
                <th style="text-align:right; padding:8px 6px; font-size:13px; color:#2e3250;">예상등급</th>
              </tr>
            </thead>
            <tbody id="rt-rows"></tbody>
          </table>
          <div id="rt-comments" style="position:relative; z-index:1; margin-top:22px;"></div>
          <div style="flex:1;"></div>
          <p style="position:relative; z-index:1; font-size:11px; color:#b8bcd0; text-align:center;">본 성적표는 대치프라임 학원 자체 평가 결과입니다.</p>
        </div>
        <div class="flex gap-2 p-4 border-t border-gray-100">
          <button id="preview-close-btn" class="flex-1 px-4 py-2 rounded-lg bg-gray-100 text-gray-700 text-sm font-bold hover:bg-gray-200">
            닫기
          </button>
          <button id="preview-download-btn" class="flex-1 px-4 py-2 rounded-lg bg-brand text-white text-sm font-bold hover:bg-brand-dark">
            JPG 다운로드
          </button>
        </div>
      </div>
    </div>

    <script>
      import { supabase } from '../lib/supabase';
      import { toJpeg } from 'html-to-image';

      const GRADES = ['초5', '초6', '중1', '중2', '중3', '고1', '고2', '고3'];
      const SUBJECTS = ['국어', '영어', '수학', '과학'];

      function escHtml(str: unknown) {
        return String(str ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      // ── 탭 전환 ──────────────────────────────
      const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
      const tabPanels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');
      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          tabButtons.forEach((b) => b.classList.remove('border-brand', 'text-brand-dark'));
          tabButtons.forEach((b) => b.classList.add('border-transparent', 'text-gray-400'));
          btn.classList.add('border-brand', 'text-brand-dark');
          btn.classList.remove('border-transparent', 'text-gray-400');
          const target = btn.dataset.tab;
          tabPanels.forEach((p) => (p.hidden = p.dataset.tabPanel !== target));
        });
      });

      // ── 엑셀 파싱 공통 ──────────────────────────────
      async function loadXlsxLib() {
        if ((window as any).XLSX) return;
        await new Promise<void>((resolve, reject) => {
          const script = document.createElement('script');
          script.src = 'https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';
          script.onload = () => resolve();
          script.onerror = reject;
          document.head.appendChild(script);
        });
      }

      // ── 통계 재계산 (같은 exam_id + grade + subject 그룹) ──────────────────────────────
      async function recomputeGroup(examId: string, grade: string, subject: string) {
        const { data: rows, error } = await supabase
          .from('rc_scores')
          .select('id, score')
          .eq('exam_id', examId)
          .eq('grade', grade)
          .eq('subject', subject);
        if (error || !rows || rows.length === 0) return;

        const sorted = [...rows].sort((a, b) => b.score - a.score);
        let rank = 0;
        let prevScore: number | null = null;
        let seen = 0;
        const size = sorted.length;
        const avg = sorted.reduce((a, b) => a + b.score, 0) / size;
        const variance = sorted.reduce((a, b) => a + (b.score - avg) ** 2, 0) / size;
        const stddev = Math.sqrt(variance);

        for (const row of sorted) {
          seen++;
          if (row.score !== prevScore) {
            rank = seen;
            prevScore = row.score;
          }
          await supabase
            .from('rc_scores')
            .update({
              class_avg: Math.round(avg * 10) / 10,
              class_stddev: Math.round(stddev * 10) / 10,
              class_rank: rank,
              class_size: size,
            })
            .eq('id', row.id);
        }
      }

      // ── 새 시험 만들기 ──────────────────────────────
      const gradeCheckboxContainer = document.getElementById('grade-checkboxes') as HTMLElement;
      gradeCheckboxContainer.innerHTML = GRADES.map(
        (g) => `
        <label class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200 text-sm cursor-pointer has-[:checked]:bg-brand-light has-[:checked]:border-brand">
          <input type="checkbox" value="${g}" class="new-exam-grade accent-[#747ba2]" />
          ${g}
        </label>`
      ).join('');

      const subjectCheckboxContainer = document.getElementById('subject-checkboxes') as HTMLElement;
      subjectCheckboxContainer.innerHTML = SUBJECTS.map(
        (s) => `
        <label class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200 text-sm cursor-pointer has-[:checked]:bg-brand-light has-[:checked]:border-brand">
          <input type="checkbox" value="${s}" class="new-exam-subject accent-[#747ba2]" />
          ${s}
        </label>`
      ).join('');

      document.getElementById('create-exam-btn')?.addEventListener('click', async () => {
        const resultEl = document.getElementById('create-exam-result') as HTMLElement;
        const grades = Array.from(document.querySelectorAll<HTMLInputElement>('.new-exam-grade:checked')).map((el) => el.value);
        const subjects = Array.from(document.querySelectorAll<HTMLInputElement>('.new-exam-subject:checked')).map((el) => el.value);
        const name = (document.getElementById('new-exam-name') as HTMLInputElement).value.trim();
        const start = (document.getElementById('new-exam-start') as HTMLInputElement).value;
        const end = (document.getElementById('new-exam-end') as HTMLInputElement).value;

        if (grades.length === 0 || subjects.length === 0 || !name || !start || !end) {
          resultEl.textContent = '대상학년, 과목, 시험 이름, 시행 기간을 모두 입력해주세요.';
          return;
        }

        const { error } = await supabase
          .from('rc_exams')
          .insert({ grades, subjects, name, period_start: start, period_end: end });
        if (error) {
          resultEl.textContent = `만들기 실패: ${error.message}`;
          return;
        }

        resultEl.textContent = '시험을 만들었습니다.';
        (document.getElementById('new-exam-name') as HTMLInputElement).value = '';
        (document.getElementById('new-exam-start') as HTMLInputElement).value = '';
        (document.getElementById('new-exam-end') as HTMLInputElement).value = '';
        document.querySelectorAll<HTMLInputElement>('.new-exam-grade:checked').forEach((el) => (el.checked = false));
        document.querySelectorAll<HTMLInputElement>('.new-exam-subject:checked').forEach((el) => (el.checked = false));

        await loadExams();
        await loadReportExamOptions();
      });

      // ── 시험 목록 ──────────────────────────────
      async function loadExams() {
        const tbody = document.getElementById('exams-tbody') as HTMLElement;
        const { data, error } = await supabase
          .from('rc_exams')
          .select('id, grades, subjects, name, period_start, period_end, rc_scores(id)')
          .order('period_start', { ascending: false });
        if (error) {
          console.error(error);
          return;
        }
        tbody.innerHTML =
          (data ?? [])
            .map((exam: any) => {
              return `
              <tr class="border-b border-gray-100 cursor-pointer hover:bg-gray-50" data-open-exam="${exam.id}">
                <td class="py-2 pr-4">${escHtml((exam.grades ?? []).join(', '))}</td>
                <td class="py-2 pr-4">${escHtml((exam.subjects ?? []).join(', '))}</td>
                <td class="py-2 pr-4">${escHtml(exam.name)}</td>
                <td class="py-2 pr-4 whitespace-nowrap">${escHtml(exam.period_start)} ~ ${escHtml(exam.period_end)}</td>
                <td class="py-2 pr-4">${exam.rc_scores.length}</td>
                <td class="py-2">
                  <button data-delete-exam="${exam.id}" class="text-red-600 text-xs hover:underline">삭제</button>
                </td>
              </tr>`;
            })
            .join('') || '<tr><td colspan="6" class="py-6 text-gray-400 text-sm text-center">등록된 시험이 없습니다.</td></tr>';

        tbody.querySelectorAll<HTMLElement>('[data-open-exam]').forEach((tr) => {
          tr.addEventListener('click', () => openExamDetail(tr.dataset.openExam!));
        });
        tbody.querySelectorAll<HTMLButtonElement>('[data-delete-exam]').forEach((btn) => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            if (!confirm('이 시험과 관련된 모든 성적을 삭제할까요?')) return;
            await supabase.from('rc_exams').delete().eq('id', btn.dataset.deleteExam!);
            await loadExams();
            await loadReportExamOptions();
          });
        });
      }

      // ── 시험 상세(명단 관리) 모달 ──────────────────────────────
      const examDetailModal = document.getElementById('exam-detail-modal') as HTMLElement;
      let currentExam: {
        id: string;
        grades: string[];
        subjects: string[];
        name: string;
        period_start: string;
        period_end: string;
        comment: string;
      } | null = null;

      const addGradeSelect = document.getElementById('ed-add-grade') as HTMLSelectElement;
      addGradeSelect.innerHTML = GRADES.map((g) => `<option value="${g}">${g}</option>`).join('');

      const addSubjectSelect = document.getElementById('ed-add-subject') as HTMLSelectElement;
      addSubjectSelect.innerHTML = SUBJECTS.map((s) => `<option value="${s}">${s}</option>`).join('');

      async function openExamDetail(examId: string) {
        const { data: exam, error } = await supabase
          .from('rc_exams')
          .select('id, grades, subjects, name, period_start, period_end, comment')
          .eq('id', examId)
          .single();
        if (error || !exam) {
          alert('시험 정보를 불러오지 못했습니다.');
          return;
        }
        currentExam = exam;
        (document.getElementById('ed-title') as HTMLElement).textContent = exam.name;
        (document.getElementById('ed-meta') as HTMLElement).textContent =
          `대상학년: ${(exam.grades ?? []).join(', ')} · 과목: ${(exam.subjects ?? []).join(', ')} · 시행기간: ${exam.period_start} ~ ${exam.period_end}`;
        (document.getElementById('ed-upload-result') as HTMLElement).textContent = '';
        (document.getElementById('ed-comment') as HTMLTextAreaElement).value = exam.comment ?? '';
        (document.getElementById('ed-comment-result') as HTMLElement).textContent = '';
        examDetailModal.hidden = false;
        await loadRoster();
      }

      document.getElementById('ed-close-btn')?.addEventListener('click', () => {
        examDetailModal.hidden = true;
        currentExam = null;
      });

      document.getElementById('ed-comment-save-btn')?.addEventListener('click', async () => {
        if (!currentExam) return;
        const resultEl = document.getElementById('ed-comment-result') as HTMLElement;
        const comment = (document.getElementById('ed-comment') as HTMLTextAreaElement).value;
        const { error } = await supabase.from('rc_exams').update({ comment }).eq('id', currentExam.id);
        resultEl.textContent = error ? `저장 실패: ${error.message}` : '저장되었습니다.';
        if (!error) currentExam.comment = comment;
      });

      async function loadRoster() {
        if (!currentExam) return;
        const tbody = document.getElementById('ed-roster-tbody') as HTMLElement;
        const { data, error } = await supabase
          .from('rc_scores')
          .select('id, grade, subject, student_name, score, class_avg, class_stddev, class_rank, class_size')
          .eq('exam_id', currentExam.id)
          .order('grade')
          .order('subject')
          .order('student_name');
        if (error) {
          console.error(error);
          return;
        }
        renderRoster(data ?? []);
      }

      function renderRoster(rows: any[]) {
        const tbody = document.getElementById('ed-roster-tbody') as HTMLElement;
        tbody.innerHTML =
          rows
            .map(
              (r) => `
              <tr class="border-b border-gray-100" data-row-id="${r.id}">
                <td class="py-2 pr-3">${escHtml(r.grade)}</td>
                <td class="py-2 pr-3">${escHtml(r.subject)}</td>
                <td class="py-2 pr-3 font-medium">${escHtml(r.student_name)}</td>
                <td class="py-2 pr-3" data-cell="score">${r.score}</td>
                <td class="py-2 pr-3 text-gray-500">${r.class_avg}</td>
                <td class="py-2 pr-3 text-gray-500">${r.class_stddev}</td>
                <td class="py-2 pr-3">${r.class_size}명 중 ${r.class_rank}등</td>
                <td class="py-2 whitespace-nowrap">
                  <button data-edit-row="${r.id}" class="text-brand text-xs hover:underline mr-2">수정</button>
                  <button data-delete-row="${r.id}" class="text-red-600 text-xs hover:underline">삭제</button>
                </td>
              </tr>`
            )
            .join('') || '<tr><td colspan="8" class="py-6 text-gray-400 text-sm text-center">등록된 학생이 없습니다.</td></tr>';

        tbody.querySelectorAll<HTMLButtonElement>('[data-edit-row]').forEach((btn) => {
          btn.addEventListener('click', () => startEditRow(btn.dataset.editRow!));
        });
        tbody.querySelectorAll<HTMLButtonElement>('[data-delete-row]').forEach((btn) => {
          btn.addEventListener('click', () => deleteRow(btn.dataset.deleteRow!));
        });
      }

      function startEditRow(rowId: string) {
        const tr = document.querySelector<HTMLElement>(`tr[data-row-id="${rowId}"]`);
        if (!tr) return;
        const cell = tr.querySelector<HTMLElement>('[data-cell="score"]')!;
        const currentScore = cell.textContent;
        cell.innerHTML = `<input type="number" value="${currentScore}" class="w-20 border border-gray-200 rounded px-1.5 py-1 text-sm" />`;
        const actionsCell = tr.lastElementChild as HTMLElement;
        actionsCell.innerHTML = `
          <button data-save-row="${rowId}" class="text-brand text-xs hover:underline mr-2">저장</button>
          <button data-cancel-row="${rowId}" class="text-gray-400 text-xs hover:underline">취소</button>`;
        actionsCell.querySelector<HTMLButtonElement>('[data-save-row]')!.addEventListener('click', () => saveEditRow(rowId));
        actionsCell.querySelector<HTMLButtonElement>('[data-cancel-row]')!.addEventListener('click', () => loadRoster());
      }

      async function saveEditRow(rowId: string) {
        const tr = document.querySelector<HTMLElement>(`tr[data-row-id="${rowId}"]`);
        if (!tr || !currentExam) return;
        const input = tr.querySelector<HTMLInputElement>('[data-cell="score"] input')!;
        const score = Number(input.value);
        if (Number.isNaN(score)) {
          alert('점수를 올바르게 입력해주세요.');
          return;
        }
        const { data: row } = await supabase.from('rc_scores').select('grade, subject').eq('id', rowId).single();
        await supabase.from('rc_scores').update({ score }).eq('id', rowId);
        if (row) await recomputeGroup(currentExam.id, row.grade, row.subject);
        await loadRoster();
        await loadExams();
        await loadReportExamOptions();
      }

      async function deleteRow(rowId: string) {
        if (!currentExam) return;
        if (!confirm('이 학생 성적을 삭제할까요?')) return;
        const { data: row } = await supabase.from('rc_scores').select('grade, subject').eq('id', rowId).single();
        await supabase.from('rc_scores').delete().eq('id', rowId);
        if (row) await recomputeGroup(currentExam.id, row.grade, row.subject);
        await loadRoster();
        await loadExams();
        await loadReportExamOptions();
      }

      document.getElementById('ed-add-btn')?.addEventListener('click', async () => {
        if (!currentExam) return;
        const grade = addGradeSelect.value;
        const subject = addSubjectSelect.value;
        const nameInput = document.getElementById('ed-add-name') as HTMLInputElement;
        const scoreInput = document.getElementById('ed-add-score') as HTMLInputElement;
        const name = nameInput.value.trim();
        const score = Number(scoreInput.value);
        if (!name || Number.isNaN(score)) {
          alert('이름과 점수를 입력해주세요.');
          return;
        }
        const { error } = await supabase
          .from('rc_scores')
          .upsert(
            {
              exam_id: currentExam.id,
              grade,
              subject,
              student_name: name,
              score,
              class_avg: 0,
              class_stddev: 0,
              class_rank: 0,
              class_size: 0,
            },
            { onConflict: 'exam_id,grade,subject,student_name' }
          );
        if (error) {
          alert(`추가 실패: ${error.message}`);
          return;
        }
        await recomputeGroup(currentExam.id, grade, subject);
        nameInput.value = '';
        scoreInput.value = '';
        await loadRoster();
        await loadExams();
        await loadReportExamOptions();
      });

      // ── 엑셀 업로드 처리 (시험 상세 안에서, 학년 | 과목 | 이름 | 점수) ──────────────────────────────
      async function processExcelFile(file: File) {
        if (!currentExam) return;
        const resultEl = document.getElementById('ed-upload-result') as HTMLElement;
        resultEl.textContent = '처리 중...';

        try {
          await loadXlsxLib();
          const buf = await file.arrayBuffer();
          const XLSX = (window as any).XLSX;
          const wb = XLSX.read(buf, { type: 'array', cellDates: true });
          const sheet = wb.Sheets[wb.SheetNames[0]];
          const rows: any[][] = XLSX.utils
            .sheet_to_json(sheet, { header: 1 })
            .slice(1)
            .filter((r: any[]) => r.some((c) => c !== undefined && c !== ''));

          const byGroup = new Map<string, Map<string, number>>();
          for (const r of rows) {
            const grade = String(r[0] ?? '').trim();
            const subject = String(r[1] ?? '').trim();
            const studentName = String(r[2] ?? '').trim();
            const score = Number(r[3]);
            if (!grade || !subject || !studentName || Number.isNaN(score)) continue;
            const key = `${grade}||${subject}`;
            if (!byGroup.has(key)) byGroup.set(key, new Map());
            byGroup.get(key)!.set(studentName, score);
          }

          if (byGroup.size === 0) {
            resultEl.textContent = '읽을 수 있는 데이터가 없습니다. 컬럼 순서를 확인해주세요.';
            return;
          }

          let scoreCount = 0;
          for (const [key, studentMap] of byGroup) {
            const [grade, subject] = key.split('||');
            const scoreRows = [...studentMap.entries()].map(([student_name, score]) => ({
              exam_id: currentExam!.id,
              grade,
              subject,
              student_name,
              score,
              class_avg: 0,
              class_stddev: 0,
              class_rank: 0,
              class_size: 0,
            }));
            const { error } = await supabase.from('rc_scores').upsert(scoreRows, { onConflict: 'exam_id,grade,subject,student_name' });
            if (error) throw error;
            scoreCount += scoreRows.length;
            await recomputeGroup(currentExam!.id, grade, subject);
          }

          resultEl.textContent = `업로드 완료: ${scoreCount}명 처리됨`;
          await loadRoster();
          await loadExams();
          await loadReportExamOptions();
        } catch (err: any) {
          console.error(err);
          resultEl.textContent = `업로드 실패: ${err.message ?? err}`;
        }
      }

      document.getElementById('ed-excel-input')?.addEventListener('change', async (e) => {
        const input = e.target as HTMLInputElement;
        const file = input.files?.[0];
        if (!file) return;
        await processExcelFile(file);
        input.value = '';
      });

      // ── 성적표 탭 ──────────────────────────────
      let allStudents: { name: string; subjects: string[] }[] = [];

      async function loadReportExamOptions() {
        const select = document.getElementById('report-exam-select') as HTMLSelectElement;
        const prev = select.value;
        const { data } = await supabase
          .from('rc_exams')
          .select('id, grades, subjects, name, period_start, period_end')
          .order('period_start', { ascending: false });
        select.innerHTML = (data ?? [])
          .map(
            (e: any) =>
              `<option value="${e.id}">${escHtml((e.grades ?? []).join('/'))} · ${escHtml((e.subjects ?? []).join('/'))} · ${escHtml(e.name)} · ${escHtml(e.period_start)}~${escHtml(e.period_end)}</option>`
          )
          .join('');
        if (data?.some((e: any) => e.id === prev)) select.value = prev;
        await loadReportGradeOptions();
      }

      async function loadReportGradeOptions() {
        const examSelect = document.getElementById('report-exam-select') as HTMLSelectElement;
        const gradeSelect = document.getElementById('report-grade-select') as HTMLSelectElement;
        const prev = gradeSelect.value;
        const examId = examSelect.value;
        if (!examId) {
          gradeSelect.innerHTML = '';
          allStudents = [];
          applyStudentFilter();
          return;
        }
        const { data } = await supabase.from('rc_scores').select('grade').eq('exam_id', examId);
        const grades = [...new Set((data ?? []).map((r: any) => r.grade))].sort((a, b) => GRADES.indexOf(a) - GRADES.indexOf(b));
        gradeSelect.innerHTML = grades.map((g) => `<option value="${escHtml(g)}">${escHtml(g)}</option>`).join('');
        if (grades.includes(prev)) gradeSelect.value = prev;
        await loadStudents();
      }

      async function loadStudents() {
        const examId = (document.getElementById('report-exam-select') as HTMLSelectElement).value;
        const grade = (document.getElementById('report-grade-select') as HTMLSelectElement).value;
        if (!examId || !grade) {
          allStudents = [];
          applyStudentFilter();
          return;
        }
        const { data, error } = await supabase.from('rc_scores').select('student_name, subject').eq('exam_id', examId).eq('grade', grade);
        if (error) {
          console.error(error);
          return;
        }
        const byStudent = new Map<string, string[]>();
        (data ?? []).forEach((row: any) => {
          if (!byStudent.has(row.student_name)) byStudent.set(row.student_name, []);
          byStudent.get(row.student_name)!.push(row.subject);
        });
        allStudents = [...byStudent.entries()]
          .map(([name, subjects]) => ({ name, subjects }))
          .sort((a, b) => a.name.localeCompare(b.name, 'ko'));
        applyStudentFilter();
      }

      function applyStudentFilter() {
        const q = (document.getElementById('student-search') as HTMLInputElement).value.trim();
        const tbody = document.getElementById('students-tbody') as HTMLElement;
        const filtered = q ? allStudents.filter((s) => s.name.includes(q)) : allStudents;
        tbody.innerHTML =
          filtered
            .map(
              (s) => `
              <tr class="border-b border-gray-100">
                <td class="py-2 pr-4 font-medium">${escHtml(s.name)}</td>
                <td class="py-2 pr-4 text-gray-500">${s.subjects.length}과목</td>
                <td class="py-2">
                  <button data-preview="${escHtml(s.name)}" class="rounded-lg bg-brand text-white text-xs font-bold px-3 py-1.5 hover:bg-brand-dark">
                    미리보기
                  </button>
                </td>
              </tr>`
            )
            .join('') || '<tr><td colspan="3" class="py-6 text-gray-400 text-sm text-center">학생이 없습니다.</td></tr>';

        tbody.querySelectorAll<HTMLButtonElement>('[data-preview]').forEach((btn) => {
          btn.addEventListener('click', () => openPreview(btn.dataset.preview!));
        });
      }

      document.getElementById('report-exam-select')?.addEventListener('change', loadReportGradeOptions);
      document.getElementById('report-grade-select')?.addEventListener('change', loadStudents);
      document.getElementById('student-search')?.addEventListener('input', applyStudentFilter);

      // 5등급제(2028 수능 개편) 누적 비율 기준으로 석차/응시인원에서 예상등급 추정
      // 1등급 누적 상위 10% · 2등급 34% · 3등급 66% · 4등급 90% · 5등급 100%
      function estimateGrade(rank: number, size: number): number {
        if (size <= 0) return 5;
        const percentile = rank / size;
        const bands = [0.1, 0.34, 0.66, 0.9];
        for (let i = 0; i < bands.length; i++) {
          if (percentile <= bands[i]) return i + 1;
        }
        return 5;
      }

      function renderReportTemplate(studentName: string, name: string, grade: string, rows: any[], comment: string) {
        (document.getElementById('rt-exam-name') as HTMLElement).textContent = name;
        (document.getElementById('rt-exam-meta') as HTMLElement).textContent = grade;
        (document.getElementById('rt-student-name') as HTMLElement).textContent = studentName;

        const rowsHtml = rows
          .map(
            (r) => `
            <tr style="border-bottom:1px solid #f0f1f4;">
              <td style="padding:12px 6px; font-weight:700; color:#2e3250;">${escHtml(r.subject)}</td>
              <td style="padding:12px 6px; text-align:right; font-weight:800; font-size:17px; color:#565d82;">${r.score}점</td>
              <td style="padding:12px 6px; text-align:right; color:#8a8fad;">${r.class_avg}점</td>
              <td style="padding:12px 6px; text-align:right; color:#8a8fad;">${r.class_stddev}</td>
              <td style="padding:12px 6px; text-align:right; color:#2e3250;">${r.class_size}명 중 ${r.class_rank}등</td>
              <td style="padding:12px 6px; text-align:right; font-weight:700; color:#565d82;">${estimateGrade(r.class_rank, r.class_size)}등급</td>
            </tr>`
          )
          .join('');
        (document.getElementById('rt-rows') as HTMLElement).innerHTML = rowsHtml;

        const commentsEl = document.getElementById('rt-comments') as HTMLElement;
        commentsEl.innerHTML =
          comment && comment.trim()
            ? `
              <p style="font-size:12px; font-weight:700; color:#2e3250; margin:0 0 8px;">총평</p>
              <p style="font-size:12px; color:#565d82; line-height:1.6; margin:0; white-space:pre-wrap;">${escHtml(comment)}</p>
            `
            : '';
      }

      // ── 미리보기 모달 ──────────────────────────────
      const previewModal = document.getElementById('preview-modal') as HTMLElement;
      let currentPreview: { studentName: string; examName: string } | null = null;

      async function openPreview(studentName: string) {
        const examId = (document.getElementById('report-exam-select') as HTMLSelectElement).value;
        const grade = (document.getElementById('report-grade-select') as HTMLSelectElement).value;
        const { data: rows, error } = await supabase
          .from('rc_scores')
          .select('subject, score, class_avg, class_stddev, class_rank, class_size')
          .eq('exam_id', examId)
          .eq('grade', grade)
          .eq('student_name', studentName)
          .order('subject');
        if (error || !rows || rows.length === 0) {
          alert('성적 데이터를 불러오지 못했습니다.');
          return;
        }

        const { data: examRow } = await supabase.from('rc_exams').select('name, comment').eq('id', examId).single();
        if (!examRow) {
          alert('시험 정보를 불러오지 못했습니다.');
          return;
        }

        renderReportTemplate(studentName, examRow.name, grade, rows, examRow.comment ?? '');
        currentPreview = { studentName, examName: examRow.name };
        previewModal.hidden = false;
      }

      document.getElementById('preview-close-btn')?.addEventListener('click', () => {
        previewModal.hidden = true;
        currentPreview = null;
      });

      document.getElementById('preview-download-btn')?.addEventListener('click', async () => {
        if (!currentPreview) return;
        const node = document.getElementById('report-template')!;
        const dataUrl = await toJpeg(node, { quality: 0.95, pixelRatio: 2, backgroundColor: '#ffffff' });
        const a = document.createElement('a');
        a.href = dataUrl;
        a.download = `${currentPreview.studentName}_${currentPreview.examName}_성적표.jpg`;
        a.click();
      });

      // ── 초기화 ──────────────────────────────
      async function init() {
        await loadExams();
        await loadReportExamOptions();
      }

      init();
    </script>
  </body>
</html>
